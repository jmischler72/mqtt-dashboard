{
  "settings": {
    "retention_period_hours": 48,
    "save_sys_topics": false
  },
  "brokers": [
    {
      "name": "Local Mosquitto",
      "host": "localhost",
      "port": 1883,
      "is_enabled": true
    },
    {
      "name": "Secure Cloud Broker",
      "host": "mqtt.example.com",
      "port": 8883,
      "auth_mode": "password",
      "username": "device_user",
      "password": "secret_password",
      "tls_enabled": true,
      "tls_skip_verify": false,
      "ca_cert_file": "./certs/ca.crt",
      "is_enabled": false
    }
  ],
  "dashboards": [
    {
      "name": "Overview",
      "panels": [
        {
          "title": "Living Room Temperature",
          "panel_type": "gauge",
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 4,
          "broker_name": "Local Mosquitto",
          "config_json": {
            "topic": "home/livingroom/temperature",
            "unit": "°C",
            "gaugeType": "radial",
            "min": 0,
            "max": 40
          }
        },
        {
          "title": "Light Toggle",
          "panel_type": "toggle",
          "x": 4,
          "y": 0,
          "w": 4,
          "h": 4,
          "broker_name": "Local Mosquitto",
          "config_json": {
            "topic": "home/livingroom/light/set",
            "stateTopic": "home/livingroom/light/state",
            "onPayload": "ON",
            "offPayload": "OFF"
          }
        },
        {
          "title": "Telemetry Logs",
          "panel_type": "log",
          "x": 8,
          "y": 0,
          "w": 4,
          "h": 4,
          "broker_name": "Local Mosquitto",
          "config_json": {
            "topic": "home/#"
          }
        }
      ]
    }
  ]
}
