          "panel_type": "input",
          "x": 9,
          "y": 15,
          "w": 3,
          "h": 3,
          "config_json": {
            "topic": "test/command",
            "placeholder": "Type a command and press enter…",
            "qos": 1,
            "retain": false,
            "header_meta_pinned": true
          },
          "broker_name": "Mosquitto Plain"
        },
        {
