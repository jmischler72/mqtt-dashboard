        },
        {
          "title": "Heartbeat (enabled)",
          "panel_type": "cron",
          "x": 4,
          "y": 18,
          "w": 4,
          "h": 3,
          "config_json": {
            "cron_expr": "* * * * *",
            "topic": "test/heartbeat",
            "payload": "{\"status\": \"healthy\", \"from\": \"cron panel\"}",
            "qos": 0,
            "retain": false,
            "enabled": true,
            "header_meta_pinned": true
          },
          "broker_name": "Mosquitto Plain"
        },
        {
