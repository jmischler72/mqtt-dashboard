            "showQos": true,
            "showRetained": true,
            "header_meta_pinned": true
          },
          "broker_name": "Mosquitto Plain"
        },
        {
          "title": "Climate (smooth, area, legend)",
          "panel_type": "graph",
          "x": 0,
