            "curve": "smooth",
            "showArea": true,
            "showPoints": false,
            "showLegend": true,
            "yMin": null,
            "yMax": null,
            "header_meta_pinned": true
          },
          "broker_name": "Mosquitto Plain"
        },
        {
          "title": "Power draw (step, fixed axis)",
          "panel_type": "graph",
          "x": 6,
          "y": 10,
          "w": 3,
          "h": 5,
          "config_json": {
